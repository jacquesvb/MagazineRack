{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for the Magazine Rack window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "sql:default",
    "sql:allow-execute",
    "fs:default",
    { "identifier": "fs:allow-exists", "allow": [{ "path": "$APPLOCALDATA/pdfs" }, { "path": "$APPLOCALDATA/pdfs/**" }] },
    { "identifier": "fs:allow-read-file", "allow": [{ "path": "$APPLOCALDATA/pdfs" }, { "path": "$APPLOCALDATA/pdfs/**" }] },
    { "identifier": "fs:allow-write-file", "allow": [{ "path": "$APPLOCALDATA/pdfs" }, { "path": "$APPLOCALDATA/pdfs/**" }] },
    { "identifier": "fs:allow-remove", "allow": [{ "path": "$APPLOCALDATA/pdfs" }, { "path": "$APPLOCALDATA/pdfs/**" }] },
    { "identifier": "fs:allow-mkdir", "allow": [{ "path": "$APPLOCALDATA/pdfs" }, { "path": "$APPLOCALDATA/pdfs/**" }] },
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://archive.org/**" },
        { "url": "https://*.archive.org/**" }
      ]
    }
  ]
}
